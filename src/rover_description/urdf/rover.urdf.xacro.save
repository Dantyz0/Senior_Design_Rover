<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="duck_catcher_rover">

  <!-- ================= CONSTANTS & DIMENSIONS ================= -->
  <xacro:property name="chassis_length" value="0.80"/>
  <xacro:property name="chassis_width"  value="0.45"/>
  <xacro:property name="chassis_height" value="0.20"/>
  <xacro:property name="chassis_mass"   value="15.0"/>

  <!-- Hoverboard Wheels (approx 6.5" to 8" diameter) -->
  <xacro:property name="wheel_radius"   value="0.10"/>
  <xacro:property name="wheel_width"    value="0.06"/>
  <xacro:property name="wheel_mass"     value="2.5"/>
  <xacro:property name="wheel_separation" value="0.52"/>

  <!-- Rear Casters (Zero-turn setup) -->
  <xacro:property name="caster_radius"  value="0.05"/>
  <xacro:property name="caster_mass"    value="0.75"/>

  <!-- ================= INERTIA MACROS ================= -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (w*w + d*d)}" iyz="0.0"
               izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= BASE LINK ================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_height}" d="${chassis_length}"/>
  </link>

  <!-- ================= FRONT DRIVE WHEELS ================= -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <!-- Positioned toward front (-X) -->
      <origin xyz="0.25 ${y_reflect * wheel_separation / 2} 0" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect="1" />
  <xacro:drive_wheel prefix="right" y_reflect="-1" />

  <!-- ================= REAR CASTERS ================= -->
  <xacro:macro name="caster_wheel" params="prefix y_reflect">
    <link name="${prefix}_caster">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="metallic"><color rgba="0.7 0.7 0.7 1.0"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="-0.32 ${y_reflect * (chassis_width / 2 - 0.05)} -${wheel_radius - caster_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="left"  y_reflect="1"/>
  <xacro:caster_wheel prefix="right" y_reflect="-1"/>

  <!-- ================= ARM ATTACHMENT POINT ================= -->
    <!-- Mount the RoArm-M2-S at the front edge of the top deck -->
  <link name="arm_mount_plate">
    <visual>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
      <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
    </visual>
  </link>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount_plate"/>
    <origin xyz="0.25 0 ${chassis_height}" rpy="0 0 0"/>
  </joint>

<!-- ================= ROARM-M2-S ATTACHMENT ================= -->
  <!-- Import the Waveshare M2 Arm -->
  <xacro:include filename="$(find roarm_description)/urdf/roarm_m2/roarm_m2.xacro" />

  <!-- Bolt the arm's base to the rover's mount plate -->
  <joint name="arm_chassis_joint" type="fixed">
    <parent link="arm_mount_plate"/>
    <child link="roarm_base_link"/> 
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

<!-- ================= GAZEBO SURFACE FRICTION ================= -->
  <!-- Low friction on front casters so they can slide laterally during zero-turns -->
  <gazebo reference="left_caster">
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

  <gazebo reference="right_caster">
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

  <!-- High grip on rear hoverboard drive wheels -->
  <gazebo reference="left_wheel">
    <mu1 value="1.0"/>
    <mu2 value="1.0"/>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1 value="1.0"/>
    <mu2 value="1.0"/>
  </gazebo>

<!-- ================= VIRTUAL CAMERA ================= -->
  
  <!-- The physical box representing the camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.1 0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Mount the camera to the chassis -->
  <joint name="camera_joint" type="fixed">
    <parent link="gripper_link"/> <!-- Change this if your chassis has a different name -->
    <child link="camera_link"/>
    <!-- Positioned slightly forward and up from the chassis center -->
    <origin xyz="0.05 0 0.05" rpy="0 0 0"/> 
  </joint>

  <!-- The Gazebo plugin that actually renders the video feed -->
<!-- Modern Gazebo (Ignition) Sensor -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <topic>front_camera/image_raw</topic>
    </sensor>
  </gazebo>

<!-- Force Gazebo to load the sensor system so cameras actually render -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>
<!-- ================= MOVEIT 2 GAZEBO BRIDGE ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_moveit_config)/config/ros2_controllers.yaml</parameters>
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

<!-- ================= VIRTUAL HARDWARE INTERFACES ================= -->

  <xacro:unless value="${'$(optenv USE_MOCK_HARDWARE false)' == 'true'}">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="base_link_to_link1">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="link1_to_link2">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="link2_to_link3">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="link3_to_gripper_link">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:unless>

<!-- ================= GAZEBO DIFF-DRIVE PLUGIN (LYRICAL LUTH) ================= -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_wheel_torque>50</max_wheel_torque>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>
