<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="duck_catcher_rover">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import duck_catcher_rover urdf file -->
    <xacro:include filename="$(find rover_description)/urdf/rover.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="duck_catcher_rover.ros2_control.xacro" />


    <xacro:duck_catcher_rover_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
